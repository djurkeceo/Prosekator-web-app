# MongoDB connection string. Use the same database as the previous version.
# MONGO_URI and MONGODB_URI are both supported; MONGO_URI has priority.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/prosekator

# Secret used to sign the HttpOnly session cookie (JWT, HS256).
# Use a long random value, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Public URL of the deployed site (used for canonical links, sitemap and OG metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
